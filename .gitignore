.DS_Store

# Local runtime configuration and secrets.
agent.yaml
xiaoai-agent/agent.yaml
xiaoai-agent/AGENT_SECRETS.local.md
*.local.md

# Rust build outputs.
target/
xiaoai-agent/target/

# Open-XiaoAI patch tool generated firmware/output.
deploy/client-patch/temp/
deploy/client-patch/assets/*
!deploy/client-patch/assets/
!deploy/client-patch/assets/.gitkeep

# JS dependencies.
node_modules/
deploy/client-patch/node_modules/

# Device/test logs and transient audio.
*.log
*.pcm
*.wav
*.aiff
*.s16le
xiaoai_asr_probe/libaivs_sdk.so

experiments/
backup/

# LX06 local build/backup artifacts (firmware images, dumps, parts.env).
deploy/lx06/work/
deploy/lx06/analysis/**/extracted/
deploy/lx06/analysis/**/rootfs/
deploy/lx06/analysis/**/*.img
deploy/lx06/analysis/**/*.squashfs

.idea/
.xcodemap/
*.bak
*.tar.gz
*.tar.bz2